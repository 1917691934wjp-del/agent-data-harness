# =============================================================================
# DeepSeek (default)
# Create a key at https://platform.deepseek.com/api_keys
# =============================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fallback when a YAML llm.model is omitted.
DEEPSEEK_MODEL=deepseek-flash

# =============================================================================
# Azure OpenAI (optional, for provider: azure_openai)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# =============================================================================
# Database Configuration
# All values can be set via environment variables OR in YAML config files.
# Environment variables take precedence over YAML values.
# Connection strings take precedence over individual connection parameters.
# =============================================================================

# -----------------------------------------------------------------------------
# Databricks
# -----------------------------------------------------------------------------
DATABRICKS_HOSTNAME=your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxx
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_TOKEN=dapi...

# -----------------------------------------------------------------------------
# Azure SQL Database
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or password
# -----------------------------------------------------------------------------
AZURE_SQL_CONNECTION_STRING=
# OR individual parameters:
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USERNAME=your-username
AZURE_SQL_PASSWORD=
AZURE_SQL_USE_AAD=false
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# -----------------------------------------------------------------------------
# Azure Synapse Analytics
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or password
# -----------------------------------------------------------------------------
SYNAPSE_CONNECTION_STRING=
# OR individual parameters:
SYNAPSE_SERVER=your-workspace.sql.azuresynapse.net
SYNAPSE_DATABASE=your-database
SYNAPSE_USERNAME=your-username
SYNAPSE_PASSWORD=
SYNAPSE_USE_AAD=false
SYNAPSE_DRIVER=ODBC Driver 18 for SQL Server
SYNAPSE_POOL=Built-in

# -----------------------------------------------------------------------------
# Azure Cosmos DB
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or key
# -----------------------------------------------------------------------------
COSMOS_CONNECTION_STRING=
# OR individual parameters:
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DATABASE=your-database
COSMOS_CONTAINER=your-container
COSMOS_KEY=
COSMOS_USE_AAD=false

# -----------------------------------------------------------------------------
# PostgreSQL
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or password
# -----------------------------------------------------------------------------
POSTGRES_CONNECTION_STRING=
# OR individual parameters:
POSTGRES_HOST=your-server.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=your-database
POSTGRES_USERNAME=your-username
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_USE_AAD=false

# -----------------------------------------------------------------------------
# Google BigQuery
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
BIGQUERY_DATASET=your-dataset
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BIGQUERY_CREDENTIALS_JSON=

# =============================================================================
# Visualization (Optional)
# Requires Azure Container Apps Dynamic Sessions for secure code execution.
# See docs/CONFIGURATION.md for setup instructions.
# =============================================================================
AZURE_SESSIONS_POOL_ENDPOINT=https://eastus.dynamicsessions.io/subscriptions/xxx/resourceGroups/xxx/sessionPools/xxx
# Local sample datasets (no remote database credentials needed).
DATA_AGENT_SAMPLE_MODE=false
DATA_AGENT_SAMPLE_DIR=scripts/data

# Multi-user login: setup_history.py prompts for the initial administrator password.
# Password hashes are stored in local_history/accounts.sqlite, not in .env.
# Keep this signing secret stable across restarts.
CHAINLIT_AUTH_SECRET=
DATA_AGENT_LOGIN_USER=admin
# Legacy bootstrap only. Clear after importing the existing account.
DATA_AGENT_LOGIN_PASSWORD=
# Self-registration creates accounts with NO datasource grants.
DATA_AGENT_ALLOW_REGISTRATION=true
# Optional history folder; defaults to local_history under the project root.
# DATA_AGENT_HISTORY_DIR=local_history
# Optional shared harness policy JSON (CLI/UI/A2A/live eval).
# DATA_AGENT_HARNESS_POLICY=evals/harness/runtime_policy.json
# Optional metadata-only trace directory; no prompts/results are exported.
# DATA_AGENT_HARNESS_TRACE_DIR=outputs/harness-traces
